{
  "name": "things-mcp",
  "version": "0.2.0",
  "description": "MCP server for Things 3 (Bun + bun:sqlite + Things URL scheme)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build --compile --minify --sourcemap src/index.ts --outfile bin/things-mcp",
    "typecheck": "tsc --noEmit",
    "pack:mcpb": "./pack-mcpb.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
